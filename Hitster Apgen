<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Hitster Mystery Player</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;900&display=swap');

    body {
      font-family: 'Outfit', sans-serif;
      background-color: #09090b;
      color: #fafafa;
      overscroll-behavior-y: contain;
      -webkit-tap-highlight-color: transparent;
    }

    @keyframes spinVinyl {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .vinyl-spin {
      animation: spinVinyl 6s linear infinite;
    }

    .vinyl-paused {
      animation-play-state: paused;
    }

    @keyframes eqBar {
      0%, 100% { height: 6px; }
      50% { height: 24px; }
    }

    .eq-bar {
      animation: eqBar 0.7s ease-in-out infinite;
    }

    .eq-paused {
      animation: none !important;
      height: 6px !important;
    }

    /* Clean up html5-qrcode default UI */
    #reader {
      border: none !important;
      border-radius: 1rem;
      overflow: hidden;
    }
    #reader video {
      object-fit: cover !important;
      border-radius: 1rem;
    }
    #reader__scan_region {
      background: #000;
    }
    #reader__dashboard_section_csr span,
    #reader__dashboard_section_swaplink,
    #reader__status_span {
      display: none !important;
    }
    #reader button {
      background: linear-gradient(135deg, #ec4899, #8b5cf6) !important;
      color: white !important;
      border: none !important;
      padding: 10px 20px !important;
      border-radius: 9999px !important;
      font-weight: 700 !important;
      font-size: 14px !important;
      margin: 10px auto !important;
      cursor: pointer !important;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between max-w-md mx-auto bg-zinc-950 relative overflow-x-hidden">

  <!-- Header -->
  <header class="pt-5 pb-3 px-5 flex items-center justify-between border-b border-zinc-800/80 bg-zinc-950/90 backdrop-blur-md sticky top-0 z-30">
    <div class="flex items-center gap-2.5">
      <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-pink-500 via-purple-500 to-cyan-400 flex items-center justify-center shadow-lg shadow-pink-500/20">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9l10.5-3m0 6.553v3.75a2.25 2.25 0 01-1.632 2.163l-1.32.377a1.803 1.803 0 11-.99-3.467l2.31-.66a2.25 2.25 0 001.632-2.163zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 01-1.632 2.163l-1.32.377a1.803 1.803 0 01-.99-3.467l2.31-.66A2.25 2.25 0 009 15.553z" />
        </svg>
      </div>
      <div>
        <h1 class="font-black text-lg tracking-tight bg-gradient-to-r from-pink-400 via-purple-400 to-cyan-400 bg-clip-text text-transparent">
          HITSTER SCANNER
        </h1>
        <p class="text-[11px] text-zinc-400 -mt-1">GitHub & Blind Audio Edition</p>
      </div>
    </div>

    <span id="privacyBadge" class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center gap-1">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      Spoiler-vrij
    </span>
  </header>

  <!-- Main Content -->
  <main class="flex-1 p-5 pb-28">

    <!-- TAB 1: SCANNER -->
    <section id="tab-scanner" class="space-y-5">
      <div class="text-center space-y-1">
        <h2 class="text-xl font-bold text-white">Scan een muziekkaart</h2>
        <p class="text-sm text-zinc-400">Richt je camera op de QR-code. De titel blijft geheim.</p>
      </div>

      <!-- Camera Viewport -->
      <div class="relative rounded-2xl bg-zinc-900 border border-zinc-800 p-2 shadow-2xl">
        <div id="reader" class="w-full min-h-[280px] bg-black flex items-center justify-center rounded-xl overflow-hidden"></div>
      </div>

      <!-- Scanner Controls -->
      <div class="flex gap-3">
        <button id="btnStartScan" onclick="startScanner()" class="flex-1 py-3.5 px-4 rounded-xl font-bold text-sm bg-gradient-to-r from-pink-500 to-purple-600 text-white shadow-lg shadow-pink-500/25 active:scale-95 transition">
          Camera Starten
        </button>
        <button id="btnStopScan" onclick="stopScanner()" class="hidden flex-1 py-3.5 px-4 rounded-xl font-bold text-sm bg-zinc-800 text-zinc-200 border border-zinc-700 active:scale-95 transition">
          Camera Stoppen
        </button>
      </div>

      <!-- Manual Test Input (Handig om GitHub link direct te testen) -->
      <div class="pt-4 border-t border-zinc-800/80">
        <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500 mb-2">Handmatige test (zonder camera)</p>
        <div class="flex gap-2">
          <input id="manualUrlInput" type="url" placeholder="Plak hier een GitHub MP3 link..." class="flex-1 bg-zinc-900 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-purple-500" />
          <button onclick="handleManualInput()" class="px-4 py-2.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-sm font-bold text-cyan-400 border border-zinc-700 active:scale-95 transition">
            Speel
          </button>
        </div>
      </div>
    </section>

    <!-- TAB 2: BLIND PLAYER -->
    <section id="tab-player" class="hidden space-y-6">
      <!-- Status Banner -->
      <div class="text-center">
        <span id="playerStatusText" class="inline-block text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full bg-purple-500/15 text-purple-300 border border-purple-500/30">
          Klaar om te luisteren
        </span>
      </div>

      <!-- Mystery Card / Vinyl View -->
      <div id="mysteryCard" class="relative rounded-3xl bg-gradient-to-b from-zinc-900 to-zinc-950 border border-zinc-800 p-6 shadow-2xl flex flex-col items-center justify-center min-h-[310px] transition-all duration-500">

        <!-- UNREVEALED STATE -->
        <div id="unrevealedView" class="flex flex-col items-center text-center space-y-5 w-full">
          <!-- Vinyl Disc -->
          <div class="relative w-44 h-44 flex items-center justify-center">
            <div id="vinylDisc" class="w-44 h-44 rounded-full bg-zinc-950 border-4 border-zinc-800 shadow-[0_0_40px_rgba(236,72,153,0.25)] flex items-center justify-center vinyl-spin vinyl-paused relative">
              <!-- Vinyl Grooves -->
              <div class="w-36 h-36 rounded-full border border-zinc-800/80 flex items-center justify-center">
                <div class="w-28 h-28 rounded-full border border-zinc-800/80 flex items-center justify-center">
                  <div class="w-20 h-20 rounded-full border border-zinc-800/80 flex items-center justify-center">
                    <!-- Center Neon Label -->
                    <div class="w-16 h-16 rounded-full bg-gradient-to-tr from-pink-500 via-purple-600 to-cyan-500 flex items-center justify-center shadow-inner">
                      <div class="w-4 h-4 rounded-full bg-zinc-950 border-2 border-white/40"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Equalizer Bars -->
          <div class="flex items-end justify-center gap-1.5 h-7">
            <span class="eq-bar eq-paused w-1.5 bg-pink-500 rounded-full" style="animation-delay: 0.0s"></span>
            <span class="eq-bar eq-paused w-1.5 bg-purple-500 rounded-full" style="animation-delay: 0.2s"></span>
            <span class="eq-bar eq-paused w-1.5 bg-cyan-400 rounded-full" style="animation-delay: 0.4s"></span>
            <span class="eq-bar eq-paused w-1.5 bg-pink-500 rounded-full" style="animation-delay: 0.1s"></span>
            <span class="eq-bar eq-paused w-1.5 bg-purple-500 rounded-full" style="animation-delay: 0.3s"></span>
          </div>

          <div>
            <h3 class="text-xl font-black text-white tracking-tight">??? MYSTERY TRACK ???</h3>
            <p class="text-xs text-zinc-400 mt-1">Bestandsnaam en titel zijn verborgen</p>
          </div>
        </div>

        <!-- REVEALED STATE -->
        <div id="revealedView" class="hidden flex-col items-center text-center space-y-4 w-full py-2">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
            Ontmaskerd!
          </span>

          <div id="revealYearBox" class="py-2 px-6 rounded-2xl bg-gradient-to-r from-pink-500/20 via-purple-500/20 to-cyan-500/20 border border-pink-500/30">
            <span class="text-[11px] uppercase tracking-widest text-zinc-400 block">Jaartal</span>
            <span id="revealYear" class="text-5xl font-black bg-gradient-to-r from-pink-400 via-purple-300 to-cyan-400 bg-clip-text text-transparent">
              ????
            </span>
          </div>

          <div class="space-y-1 max-w-full px-2">
            <h3 id="revealTitle" class="text-2xl font-black text-white break-words leading-tight">
              Onbekende Titel
            </h3>
            <p id="revealArtist" class="text-base font-semibold text-purple-300 break-words">
              Onbekende Artiest
            </p>
          </div>

          <p id="revealRawFilename" class="text-[11px] text-zinc-500 font-mono break-all pt-2 border-t border-zinc-800/80 w-full">
            bestand.mp3
          </p>
        </div>
      </div>

      <!-- Error Message Box -->
      <div id="audioErrorBox" class="hidden p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 text-xs text-center">
        Kan audiobestand niet laden. Controleer of je GitHub repository <strong>publiek</strong> staat en of het bestand bestaat.
      </div>

      <!-- Audio Controls (Zonder tijdsbalk die bestandsduur weergeeft) -->
      <div class="flex items-center justify-center gap-5">
        <button onclick="seekAudio(-10)" class="w-12 h-12 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-300 hover:text-white active:scale-90 transition" title="-10 sec">
          <span class="text-xs font-bold">-10s</span>
        </button>

        <button id="btnPlayPause" onclick="togglePlayPause()" class="w-16 h-16 rounded-full bg-gradient-to-tr from-pink-500 to-purple-600 flex items-center justify-center text-white shadow-xl shadow-pink-500/30 active:scale-90 transition">
          <svg id="iconPlay" class="w-7 h-7 ml-1" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <svg id="iconPause" class="w-7 h-7 hidden" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
          </svg>
        </button>

        <button onclick="seekAudio(10)" class="w-12 h-12 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-300 hover:text-white active:scale-90 transition" title="+10 sec">
          <span class="text-xs font-bold">+10s</span>
        </button>
      </div>

      <!-- Action Buttons: Reveal & Next Scan -->
      <div class="space-y-3 pt-2">
        <button id="btnReveal" onclick="handleRevealClick()" class="w-full py-4 px-5 rounded-2xl font-black text-base bg-zinc-900 border-2 border-cyan-500/50 text-cyan-300 hover:bg-cyan-500/10 active:scale-95 transition shadow-lg">
          👀 Onthul Titel & Jaartal
        </button>

        <button onclick="nextCard()" class="w-full py-3.5 px-5 rounded-2xl font-bold text-sm bg-zinc-800/80 text-zinc-300 hover:bg-zinc-800 active:scale-95 transition">
          📷 Volgende Kaart Scannen
        </button>
      </div>
    </section>

    <!-- TAB 3: QR GENERATOR VOOR GITHUB -->
    <section id="tab-generator" class="hidden space-y-5">
      <div class="space-y-1">
        <h2 class="text-xl font-bold text-white">GitHub QR Generator</h2>
        <p class="text-xs text-zinc-400">
          Plak een GitHub-link. De app zet hem automatisch om naar een directe audio-stream link en maakt een QR-code.
        </p>
      </div>

      <div class="space-y-3 bg-zinc-900/70 p-4 rounded-2xl border border-zinc-800">
        <div>
          <label class="block text-xs font-semibold text-zinc-400 mb-1">GitHub URL naar audiobestand (.mp3 / .m4a / .wav)</label>
          <input id="genGithubUrl" type="url" placeholder="https://github.com/gebruiker/repo/blob/main/1985%20-%20Queen%20-%20Radio%20Ga%20Ga.mp3" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-xs text-white placeholder-zinc-600 focus:outline-none focus:border-pink-500" />
        </div>

        <button onclick="generateGitHubQR()" class="w-full py-3 rounded-xl font-bold text-sm bg-gradient-to-r from-cyan-500 to-purple-600 text-white shadow-lg active:scale-95 transition">
          Genereer QR-Code
        </button>
      </div>

      <!-- Output QR -->
      <div id="qrOutputContainer" class="hidden flex-col items-center bg-white text-zinc-950 p-6 rounded-2xl space-y-3 shadow-xl">
        <div id="qrcode" class="p-2 bg-white"></div>
        <p id="qrLabelText" class="text-xs font-bold text-center text-zinc-700 break-all"></p>
        <p class="text-[10px] text-zinc-400 text-center">Maak een screenshot of druk af op je speelkaart</p>
      </div>
    </section>

  </main>

  <!-- Bottom Navigation -->
  <nav class="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-zinc-950/95 backdrop-blur-lg border-t border-zinc-800/90 px-4 py-2.5 flex justify-around items-center z-40">
    <button onclick="switchTab('scanner')" id="nav-scanner" class="flex flex-col items-center gap-1 py-1 px-4 rounded-xl text-pink-400 transition">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 7V5a2 2 0 012-2h2m10 0h2a2 2 0 012 2v2m0 10v2a2 2 0 01-2 2h-2M7 21H5a2 2 0 01-2-2v-2M7 12h10" />
      </svg>
      <span class="text-[11px] font-bold">Scannen</span>
    </button>

    <button onclick="switchTab('player')" id="nav-player" class="flex flex-col items-center gap-1 py-1 px-4 rounded-xl text-zinc-500 hover:text-zinc-300 transition">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="text-[11px] font-bold">Speler</span>
    </button>

    <button onclick="switchTab('generator')" id="nav-generator" class="flex flex-col items-center gap-1 py-1 px-4 rounded-xl text-zinc-500 hover:text-zinc-300 transition">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
      </svg>
      <span class="text-[11px] font-bold">QR Maken</span>
    </button>
  </nav>

  <!-- Verborgen Audio Element -->
  <audio id="secretAudioPlayer" preload="auto" playsinline></audio>

  <script>
    let html5QrCode = null;
    let isScanning = false;
    let revealConfirmStep = false;
    let currentTrackInfo = {
      rawUrl: '',
      filename: '',
      title: 'Onbekend nummer',
      artist: 'Onbekende artiest',
      year: '????'
    };

    const audioEl = document.getElementById('secretAudioPlayer');

    // Tab Navigatie
    function switchTab(tabName) {
      ['scanner', 'player', 'generator'].forEach(t => {
        document.getElementById(`tab-${t}`).classList.add('hidden');
        const navBtn = document.getElementById(`nav-${t}`);
        navBtn.classList.remove('text-pink-400');
        navBtn.classList.add('text-zinc-500');
      });

      document.getElementById(`tab-${tabName}`).classList.remove('hidden');
      const activeNav = document.getElementById(`nav-${tabName}`);
      activeNav.classList.remove('text-zinc-500');
      activeNav.classList.add('text-pink-400');
    }

    // Zet standaard GitHub blob URL's automatisch om naar raw.githubusercontent.com
    function normalizeGitHubUrl(url) {
      let cleanUrl = url.trim();
      if (cleanUrl.includes('github.com') && cleanUrl.includes('/blob/')) {
        cleanUrl = cleanUrl
          .replace('https://github.com/', 'https://raw.githubusercontent.com/')
          .replace('/blob/', '/');
      }
      return cleanUrl;
    }

    // Haal artiest, titel en jaartal slim uit de bestandsnaam
    function parseTrackMetadata(url) {
      try {
        const urlObj = new URL(url);
        const pathParts = urlObj.pathname.split('/');
        let rawFilename = decodeURIComponent(pathParts[pathParts.length - 1] || 'Onbekend.mp3');

        // Verwijder extensie (.mp3, .wav, .m4a, .ogg, etc.)
        let nameWithoutExt = rawFilename.replace(/\.[^/.]+$/, '').replace(/_/g, ' ').trim();

        // Zoek een jaartal (bijv. 1950 - 2029)
        let year = '????';
        const yearMatch = nameWithoutExt.match(/\b(19\d{2}|20[0-2]\d)\b/);
        if (yearMatch) {
          year = yearMatch[1];
          // Verwijder jaartal en eventuele haakjes/streepjes eromheen voor schone titel/artiest
          nameWithoutExt = nameWithoutExt
            .replace(new RegExp(`\\(?\\b${year}\\b\\)?`), '')
            .replace(/^\s*-\s*|\s*-\s*$/g, '')
            .trim();
        }

        // Splits op ' - ' voor Artiest en Titel
        let artist = 'GitHub Audio Track';
        let title = nameWithoutExt;

        if (nameWithoutExt.includes(' - ')) {
          const parts = nameWithoutExt.split(' - ');
          artist = parts[0].trim();
          title = parts.slice(1).join(' - ').trim();
        }

        return {
          rawUrl: url,
          filename: rawFilename,
          title: title || rawFilename,
          artist: artist,
          year: year
        };
      } catch (e) {
        return {
          rawUrl: url,
          filename: url,
          title: 'Mystery Audio Track',
          artist: 'Externe Bron',
          year: '????'
        };
      }
    }

    // Overschrijf telefoon vergrendelscherm zodat de bestandsnaam niet lekt
    function applySpoilerFreeLockscreen() {
      document.title = 'Hitster Mystery Track 🎵';
      if ('mediaSession' in navigator) {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: '??? Mystery Track ???',
          artist: 'Raad het jaartal!',
          album: 'Hitster Blind Player'
        });
      }
    }

    // Start QR Scanner
    async function startScanner() {
      if (isScanning) return;

      document.getElementById('btnStartScan').classList.add('hidden');
      document.getElementById('btnStopScan').classList.remove('hidden');

      html5QrCode = new Html5Qrcode("reader");

      try {
        await html5QrCode.start(
          { facingMode: "environment" },
          { fps: 12, qrbox: { width: 230, height: 230 } },
          (decodedText) => {
            // QR-code gevonden!
            stopScanner();
            loadAndPlayTrack(decodedText);
          },
          () => {}
        );
        isScanning = true;
      } catch (err) {
        alert("Kon camera niet starten. Geef cameratoegang in je browser of gebruik HTTPS.");
        document.getElementById('btnStartScan').classList.remove('hidden');
        document.getElementById('btnStopScan').classList.add('hidden');
      }
    }

    // Stop QR Scanner
    async function stopScanner() {
      if (html5QrCode && isScanning) {
        try {
          await html5QrCode.stop();
          html5QrCode.clear();
        } catch (e) {}
      }
      isScanning = false;
      document.getElementById('btnStartScan').classList.remove('hidden');
      document.getElementById('btnStopScan').classList.add('hidden');
    }

    // Handmatige invoer testen
    function handleManualInput() {
      const val = document.getElementById('manualUrlInput').value;
      if (!val) return;
      loadAndPlayTrack(val);
    }

    // Laad en speel gescande QR-link af zonder bestandsnaam te tonen
    function loadAndPlayTrack(scannedContent) {
      let targetUrl = scannedContent.trim();

      // Ondersteuning voor JSON QR-codes (mocht iemand die ook gebruiken)
      if (targetUrl.startsWith('{')) {
        try {
          const data = JSON.parse(targetUrl);
          targetUrl = normalizeGitHubUrl(data.url || data.audio || '');
          currentTrackInfo = {
            rawUrl: targetUrl,
            filename: data.title || 'Custom QR',
            title: data.title || 'Onbekende titel',
            artist: data.artist || 'Onbekende artiest',
            year: data.year || '????'
          };
        } catch (e) {
          targetUrl = normalizeGitHubUrl(targetUrl);
          currentTrackInfo = parseTrackMetadata(targetUrl);
        }
      } else {
        targetUrl = normalizeGitHubUrl(targetUrl);
        currentTrackInfo = parseTrackMetadata(targetUrl);
      }

      // Reset UI naar verborgen modus
      resetRevealUI();
      document.getElementById('audioErrorBox').classList.add('hidden');

      // Schakel naar speler
      switchTab('player');

      // Laad audiobestand
      audioEl.src = currentTrackInfo.rawUrl;
      audioEl.load();

      applySpoilerFreeLockscreen();

      audioEl.play()
        .then(() => {
          updatePlayingState(true);
          applySpoilerFreeLockscreen();
        })
        .catch(() => {
          updatePlayingState(false);
          document.getElementById('playerStatusText').textContent = 'Tik op Play om te starten';
        });
    }

    // Audio Events
    audioEl.addEventListener('play', () => {
      updatePlayingState(true);
      applySpoilerFreeLockscreen();
    });

    audioEl.addEventListener('pause', () => {
      updatePlayingState(false);
    });

    audioEl.addEventListener('ended', () => {
      updatePlayingState(false);
      document.getElementById('playerStatusText').textContent = 'Fragment afgelopen';
    });

    audioEl.addEventListener('error', () => {
      updatePlayingState(false);
      document.getElementById('audioErrorBox').classList.remove('hidden');
      document.getElementById('playerStatusText').textContent = 'Fout bij laden audio';
    });

    function updatePlayingState(isPlaying) {
      const vinyl = document.getElementById('vinylDisc');
      const eqBars = document.querySelectorAll('.eq-bar');
      const iconPlay = document.getElementById('iconPlay');
      const iconPause = document.getElementById('iconPause');
      const statusText = document.getElementById('playerStatusText');

      if (isPlaying) {
        vinyl.classList.remove('vinyl-paused');
        eqBars.forEach(b => b.classList.remove('eq-paused'));
        iconPlay.classList.add('hidden');
        iconPause.classList.remove('hidden');
        statusText.textContent = 'Muziek speelt af...';
      } else {
        vinyl.classList.add('vinyl-paused');
        eqBars.forEach(b => b.classList.add('eq-paused'));
        iconPlay.classList.remove('hidden');
        iconPause.classList.add('hidden');
        if (audioEl.src) {
          statusText.textContent = 'Gepauzeerd';
        }
      }
    }

    function togglePlayPause() {
      if (!audioEl.src) return;
      if (audioEl.paused) {
        audioEl.play();
      } else {
        audioEl.pause();
      }
    }

    function seekAudio(seconds) {
      if (!audioEl.src || isNaN(audioEl.duration)) return;
      audioEl.currentTime = Math.max(0, Math.min(audioEl.duration, audioEl.currentTime + seconds));
    }

    // Twee-staps Onthul-knop (voorkomt per ongeluk klikken)
    function handleRevealClick() {
      const btn = document.getElementById('btnReveal');

      if (!revealConfirmStep) {
        revealConfirmStep = true;
        btn.textContent = '⚠️ Zeker weten? Tik nogmaals om te onthullen';
        btn.classList.remove('border-cyan-500/50', 'text-cyan-300');
        btn.classList.add('border-amber-500', 'text-amber-300', 'bg-amber-500/10');
        return;
      }

      // Onthul de gegevens
      document.getElementById('unrevealedView').classList.add('hidden');
      const revealedView = document.getElementById('revealedView');
      revealedView.classList.remove('hidden');
      revealedView.classList.add('flex');

      document.getElementById('revealYear').textContent = currentTrackInfo.year;
      document.getElementById('revealTitle').textContent = currentTrackInfo.title;
      document.getElementById('revealArtist').textContent = currentTrackInfo.artist;
      document.getElementById('revealRawFilename').textContent = currentTrackInfo.filename;

      btn.classList.add('hidden');
      document.getElementById('playerStatusText').textContent = 'Kaart onthuld';
    }

    function resetRevealUI() {
      revealConfirmStep = false;
      document.getElementById('unrevealedView').classList.remove('hidden');
      const revealedView = document.getElementById('revealedView');
      revealedView.classList.add('hidden');
      revealedView.classList.remove('flex');

      const btn = document.getElementById('btnReveal');
      btn.classList.remove('hidden', 'border-amber-500', 'text-amber-300', 'bg-amber-500/10');
      btn.classList.add('border-cyan-500/50', 'text-cyan-300');
      btn.textContent = '👀 Onthul Titel & Jaartal';
    }

    function nextCard() {
      audioEl.pause();
      audioEl.removeAttribute('src');
      updatePlayingState(false);
      resetRevealUI();
      switchTab('scanner');
      startScanner();
    }

    // QR-code Generator voor GitHub links
    function generateGitHubQR() {
      const inputUrl = document.getElementById('genGithubUrl').value.trim();
      if (!inputUrl) return;

      const rawUrl = normalizeGitHubUrl(inputUrl);
      const qrContainer = document.getElementById('qrcode');
      qrContainer.innerHTML = '';

      new QRCode(qrContainer, {
        text: rawUrl,
        width: 200,
        height: 200,
        colorDark: "#000000",
        colorLight: "#ffffff",
        correctLevel: QRCode.CorrectLevel.M
      });

      const meta = parseTrackMetadata(rawUrl);
      document.getElementById('qrLabelText').textContent = `${meta.artist} - ${meta.title} (${meta.year})`;
      const outputBox = document.getElementById('qrOutputContainer');
      outputBox.classList.remove('hidden');
      outputBox.classList.add('flex');
    }
  </script>
</body>
</html>
